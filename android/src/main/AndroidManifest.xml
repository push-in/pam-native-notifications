<manifest xmlns:android="http://schemas.android.com/apk/res/android"><uses-permission android:name="android.permission.INTERNET" />
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
<application><provider android:name="dev.pam.notifications.PluginHostProvider" android:authorities="${applicationId}.pam.notifications.host" android:exported="false" /><receiver android:name="dev.pam.notifications.NotificationReceiver" android:exported="false" />
<receiver android:name="dev.pam.notifications.PamNotificationActionReceiver" android:exported="false" />
<receiver android:name="dev.pam.notifications.BackgroundPushReceiver" android:exported="false"><intent-filter><action android:name="dev.pam.nativeapp.action.PUSH_RECEIVED" /></intent-filter></receiver>
<receiver android:name="dev.pam.notifications.PushTokenRegistrationReceiver" android:exported="false"><intent-filter><action android:name="dev.pam.nativeapp.action.PUSH_TOKEN_REFRESHED" /></intent-filter></receiver>
<service android:name="dev.pam.notifications.PushTokenRegistrationJob" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false" />
</application></manifest>